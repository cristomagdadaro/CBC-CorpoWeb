{
  "name": "tailwind-manager",
  "version": "0.2.0",
  "private": true,
  "description": "WordPress Tailwind Manager plugin build scripts",
  "scripts": {
    "dev": "npx tailwindcss -c tailwind.config.cjs -i ./src/input.css -o ./dist/tailwind.css --watch",
    "build": "npx tailwindcss -c tailwind.config.cjs -i ./src/input.css -o ./dist/tailwind.css --minify",
    "clean": "rimraf dist/tailwind.css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.10"
  }
}
