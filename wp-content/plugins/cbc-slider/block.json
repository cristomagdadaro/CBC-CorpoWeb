{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "cbc/slider",
  "title": "CBC Slider",
  "category": "media",
  "icon": "images-alt2",
  "description": "Slider for images and videos with custom HTML overlays.",
  "textdomain": "cbc-slider",
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "slides": {
      "type": "array",
      "default": []
    },
    "autoplay": { "type": "boolean", "default": true },
    "delay": { "type": "number", "default": 5000 },
    "loop": { "type": "boolean", "default": true },
    "pauseOnHover": { "type": "boolean", "default": true },
    "showArrows": { "type": "boolean", "default": true },
    "showDots": { "type": "boolean", "default": true },
    "objectFit": { "type": "string", "default": "cover" },
    "aspectRatio": { "type": "string", "default": "16/9" },
    "height": { "type": "string", "default": "" },
    "videoMuted": { "type": "boolean", "default": true },
    "videoLoop": { "type": "boolean", "default": false },
    "videoControls": { "type": "boolean", "default": false }
  },
  "editorScript": "cbc-slider-editor",
  "editorStyle": "cbc-slider-editor",
  "style": "cbc-slider-style",
  "script": "cbc-slider-frontend"
}

